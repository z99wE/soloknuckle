#!/usr/bin/env bash
# pre-commit — runs all quality gates before allowing a commit.
# Refuses the commit if anything fails.

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

fail() { echo -e "${RED}❌ $1${NC}"; exit 1; }
warn() { echo -e "${YELLOW}⚠️  $1${NC}"; }
ok()   { echo -e "${GREEN}✅ $1${NC}"; }

echo "🛡️  Running production-hygiene pre-commit gates..."
echo ""

# ---------- 1. Secret scan ----------
echo "1/7 Scanning for secrets in staged files..."
STAGED=$(git diff --cached --name-only --diff-filter=ACMR | grep -vE '\.lock$|package-lock\.json$|yarn\.lock$|pnpm-lock\.yaml$' || true)

if [ -n "$STAGED" ]; then
  SECRET_HITS=$(echo "$STAGED" | xargs grep -lE '(AKIA[0-9A-Z]{16}|-----BEGIN [A-Z]+ PRIVATE KEY-----|ghp_[a-zA-Z0-9]{36}|sk-[a-zA-Z0-9]{32}|xox[baprs]-[a-zA-Z0-9-]+)' 2>/dev/null || true)
  if [ -n "$SECRET_HITS" ]; then
    fail "Possible secrets detected in: $SECRET_HITS"
  fi
  ENV_HITS=$(echo "$STAGED" | grep -E '^\.env$|\.env\.local$|\.env\.production$|.*\.pem$|.*\.key$' || true)
  if [ -n "$ENV_HITS" ]; then
    fail "Blocked file types in commit: $ENV_HITS"
  fi
fi
ok "no secrets detected"

# ---------- 2. Forbidden patterns ----------
echo "2/7 Scanning for forbidden patterns..."
if [ -n "$STAGED" ]; then
  FORBIDDEN=$(echo "$STAGED" | xargs grep -nE '\beval\s*\(|new Function\s*\(|child_process\.exec\s*\(' 2>/dev/null | grep -v 'node_modules' || true)
  if [ -n "$FORBIDDEN" ]; then
    warn "Forbidden patterns found — review carefully:"
    echo "$FORBIDDEN"
    echo ""
    read -p "Continue anyway? (y/N) " -n 1 -r
    echo ""
    [[ $REPLY =~ ^[Yy]$ ]] || fail "Commit blocked due to forbidden patterns"
  fi
fi
ok "no forbidden patterns"

# ---------- 3. Lint ----------
echo "3/7 Running linter..."
if [ -f package.json ] && grep -q '"lint"' package.json; then
  npm run lint --silent || fail "Lint failed. Run 'npm run lint' to fix."
  ok "lint passed"
else
  warn "no lint script found — skipping"
fi

# ---------- 4. Typecheck ----------
echo "4/7 Running typecheck..."
if [ -f package.json ] && grep -q '"typecheck"' package.json; then
  npm run typecheck --silent || fail "Typecheck failed. Run 'npm run typecheck' to fix."
  ok "typecheck passed"
elif [ -f tsconfig.json ]; then
  npx --no-install tsc --noEmit || fail "TypeScript check failed."
  ok "typecheck passed"
else
  warn "no tsconfig — skipping typecheck"
fi

# ---------- 5. Tests ----------
echo "5/7 Running tests..."
if [ -f package.json ] && grep -qE '"test"\s*:' package.json; then
  npm test --silent -- --watchAll=false 2>&1 | tail -5 || fail "Tests failed. Run 'npm test' to see what."
  ok "tests passed"
else
  warn "no test script found — skipping"
fi

# ---------- 6. A11y quick checks (web only) ----------
echo "6/7 Quick a11y checks..."
if [ -n "$STAGED" ]; then
  TSX_FILES=$(echo "$STAGED" | grep -E '\.(tsx?|jsx?|vue|svelte)$' || true)
  if [ -n "$TSX_FILES" ]; then
    IMG_NO_ALT=$(echo "$TSX_FILES" | xargs grep -lE '<img\s' 2>/dev/null | xargs grep -L 'alt=' 2>/dev/null || true)
    if [ -n "$IMG_NO_ALT" ]; then
      fail "<img> without alt attribute in: $IMG_NO_ALT"
    fi
    BTN_NO_NAME=$(echo "$TSX_FILES" | xargs grep -lE '<button' 2>/dev/null | while read f; do
      if ! grep -qE '(<button[^>]*aria-label=|<button[^>]*>[^<]+[A-Za-z])' "$f"; then echo "$f"; fi
    done || true)
    if [ -n "$BTN_NO_NAME" ]; then
      fail "<button> without accessible name in: $BTN_NO_NAME"
    fi
  fi
fi
ok "a11y checks passed"

# ---------- 7. Commit message sanity ----------
echo "7/7 Checking commit message..."
# We can't see the message yet (hooks run before message), but we check branch context
BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [[ "$BRANCH" == "main" || "$BRANCH" == "develop" ]]; then
  fail "Cannot commit directly to '$BRANCH'. Use a feature/* branch."
fi
ok "branch ok ($BRANCH)"

echo ""
echo -e "${GREEN}🎉 All pre-commit gates passed. Committing.${NC}"
