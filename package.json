{
  "name": "soloknuckle",
  "version": "1.0.0",
  "description": "Production hygiene CLI — pre-flight checks, secret scanning, agent firewall, and a visual dashboard for any project.",
  "main": "./dist/cli/index.js",
  "bin": {
    "soloknuckle": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && cd ui && npm install --include=dev && npm run build",
    "prepare": "npm run build",
    "dev": "ts-node cli/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/z99wE/soloknuckle.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/z99wE/soloknuckle/issues"
  },
  "homepage": "https://github.com/z99wE/soloknuckle#readme",
  "dependencies": {
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "inquirer": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
